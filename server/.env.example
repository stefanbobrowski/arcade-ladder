PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL — local dev (use Cloud SQL proxy connection string in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/arcade_ladder

# OAuth — create apps at console.developers.google.com and github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# URLs
API_BASE_URL=http://localhost:8080
CLIENT_ORIGIN=http://localhost:5173
