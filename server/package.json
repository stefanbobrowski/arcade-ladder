{
  "name": "arcade-ladder-server",
  "version": "1.0.0",
  "description": "Arcade Ladder backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "docker exec -i arcade-pg psql -U postgres -d arcade_ladder < src/db/migrations/001_init.sql",
    "db:sync-games": "docker exec -i arcade-pg psql -U postgres -d arcade_ladder < src/db/migrations/sync-games.sql",
    "db:reset": "docker exec -i arcade-pg psql -U postgres -d arcade_ladder -c \"TRUNCATE scores, users RESTART IDENTITY CASCADE;\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/passport": "^3.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
